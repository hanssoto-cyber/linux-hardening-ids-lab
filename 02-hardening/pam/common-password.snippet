# /etc/pam.d/common-password: línea pam_pwquality (paquete libpam-pwquality)
# Salida de: grep pam_pwquality /etc/pam.d/common-password
#
# minlen=12            longitud mínima de 12 caracteres
# ucredit=-1           al menos 1 mayúscula
# lcredit=-1           al menos 1 minúscula
# dcredit=-1           al menos 1 dígito
# ocredit=-1           al menos 1 símbolo
# reject_username      rechaza contraseñas que contengan el nombre de usuario
# enforce_for_root     aplica la política también a root
# retry=3              3 intentos antes de fallar
#
# Corrige el hallazgo AUTH-9262 de Lynis.
password requisite pam_pwquality.so retry=3 minlen=12 ucredit=-1 lcredit=-1 dcredit=-1 ocredit=-1 reject_username enforce_for_root
